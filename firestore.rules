rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assignments/{assignmentId} {
      allow read, write: if request.auth != null;
      match /submissions/{studentId} {
        allow read, write: if request.auth != null;
      }
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}