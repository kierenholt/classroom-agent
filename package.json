{
  "name": "classroom-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sync:env": "node scripts/sync_prod_env.js",
    "provision:prod": "bash scripts/provision_production.sh",
    "publish:rules": "firebase deploy --only firestore,storage --project classroom-agent-511917",
    "publish:functions": "node scripts/sync_prod_env.js && npm --prefix functions run build && firebase deploy --only functions --project classroom-agent-511917",
    "publish:hosting": "npm run build && firebase deploy --only hosting --project classroom-agent-511917",
    "publish:prod": "node scripts/sync_prod_env.js && npm --prefix functions run build && npm run build && firebase deploy --only firestore,storage,functions,hosting --project classroom-agent-511917",
    "test": "node scripts/run_tests.js",
    "test:e2e": "playwright test --workers=1",
    "test:emulator": "playwright test tests/e2e/workspace_layout_and_agent_copilot_test.spec.ts --workers=1",
    "test:live": "playwright test tests/e2e/live_classroom_assignment_lifecycle_test.spec.ts --workers=1"
  },
  "dependencies": {
    "firebase": "^11.0.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "firebase-admin": "^14.5.0",
    "googleapis": "^144.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
