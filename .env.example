# ============================================================================
# Classroom Agent — Environment Configuration Template (.env.example)
# Copy to .env.local (local emulators) and .env.production (live GCP/Firebase).
# Fail-Fast Policy: Application startup throws immediately if required vars are missing.
# ============================================================================

# --- Frontend Server & API Endpoints ---
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:5001/classroom-agent-511917/us-central1/api

# --- Firebase Web SDK Configuration (classroom-agent-511917) ---
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=classroom-agent-511917.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=classroom-agent-511917
VITE_FIREBASE_STORAGE_BUCKET=classroom-agent-511917.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=82833838117
VITE_FIREBASE_APP_ID=1:82833838117:web:6646420fa24876a1112fcc

# --- Local Firebase Emulator Configuration ---
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_STORAGE_EMULATOR_PORT=9199
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001

# --- Backend / Cloud Functions Configuration ---
GCP_PROJECT_ID=classroom-agent-511917
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- Live Google Classroom Test Sandbox Configuration ---
TEST_CLASSROOM_COURSE_ID=YOUR_COURSE_ID
TEST_GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
TEST_GOOGLE_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
TEST_TEACHER_REFRESH_TOKEN=YOUR_TEACHER_REFRESH_TOKEN
TEST_STUDENT_EMAIL=YOUR_TEST_STUDENT_EMAIL
TEST_STUDENT_REFRESH_TOKEN=YOUR_TEST_STUDENT_REFRESH_TOKEN
